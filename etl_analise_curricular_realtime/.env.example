# Banco do sistema novo. Prefira uma URL PostgreSQL completa.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Arquivo JSON da service account Google que ja possui acesso as pastas/planilhas.
GOOGLE_CREDENTIALS_FILE=C:\\caminho\\service-account.json

# O schema ja usado pelo sistema.
DB_SCHEMA=gerenciamento_concursos

# Nome da aba operacional existente nas planilhas individuais.
ANALISE_SHEET_NAME=APTOS PARA ANÁLISE
